# Copy this file to .env and fill in your Firebase project's config values.
# Firebase Console → Project Settings → General → "Your apps" → SDK setup
# and configuration → "Config".
#
# .env is where real secrets go — make sure it's in your .gitignore and
# never committed. This .env.example file (with blank values) is safe to
# commit as a reference for what's needed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary — used for flyer image uploads (Firebase Storage now requires
# a paid plan even for free-tier usage, so this replaces it). See
# ADMIN_SETUP.md for how to get these two values.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
