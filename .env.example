# Copy this file to .env and fill in your Appwrite project's values.
# See ADMIN_SETUP.md for exactly where to find/create each of these.
#
# .env is where real secrets go - make sure it's in your .gitignore and
# never committed. This .env.example file (with blank values) is safe to
# commit as a reference for what's needed.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_COLLECTION_ID=
VITE_APPWRITE_BUCKET_ID=
